---
import Base from '../../layouts/Base.astro'
import { sanityClient, imageUrl } from '../../lib/sanity.js'

const personnages = await sanityClient.fetch(`
  *[_type == "personnage"] | order(nom asc) {
    nom, surnom, slug, role,
    "imageHeroUrl": imageHero.asset->url
  }
`)

const roles = ['Tous', ...new Set(personnages.map(p => p.role).filter(Boolean))]
---

<Base title="Personnages">

<section class="hub-hero">
  <div class="hub-hero-bg"></div>
  <div class="hub-hero-content">
    <p class="hub-eyebrow">Univers · Draynera</p>
    <h1 class="hub-title">Personnages</h1>
    <div class="hub-ornament">
      <span class="hub-line"></span>
      <span class="hub-diamond"></span>
      <span class="hub-line"></span>
    </div>
    <p class="hub-desc">Découvre les habitants, héros et figures de l'univers de Draynera.</p>
  </div>
</section>

<section class="hub-main">

  <!-- Filtres -->
  <div class="hub-filtres" id="filtres">
    {roles.map(role => (
      <button
        class={`filtre-btn ${role === 'Tous' ? 'active' : ''}`}
        data-role={role}
      >
        {role}
      </button>
    ))}
  </div>

  <!-- Compteur -->
  <p class="hub-compteur" id="compteur">
    <span id="compteurNum">{personnages.length}</span> personnage{personnages.length > 1 ? 's' : ''}
  </p>

  <!-- Grille -->
  <div class="hub-grille" id="grille">
    {personnages.map(perso => (
      <a
        href={`/personnages/${perso.slug.current}`}
        class="perso-carte"
        data-role={perso.role || ''}
      >
        <div
          class="perso-carte-img"
          style={perso.imageHeroUrl ? `background-image: url(${perso.imageHeroUrl})` : ''}
        ></div>
        <div class="perso-carte-overlay"></div>
        <div class="perso-carte-content">
          {perso.role && <p class="perso-carte-role">{perso.role}</p>}
          <h2 class="perso-carte-nom">{perso.nom}</h2>
          {perso.surnom && <p class="perso-carte-surnom">{perso.surnom}</p>}
        </div>
        <div class="perso-carte-hover">
          <span class="perso-carte-cta">Voir le personnage →</span>
        </div>
      </a>
    ))}
  </div>

  <!-- Message vide -->
  <div class="hub-vide" id="hubVide" style="display:none;">
    <p>Aucun personnage dans cette catégorie.</p>
  </div>

</section>

</Base>

<style>

/* ── HERO ── */
.hub-hero {
  position: relative;
  height: 40vh;
  min-height: 320px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 56px;
  overflow: hidden;
}

.hub-hero-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 80% 100% at 50% 0%, rgba(124,77,255,0.12) 0%, transparent 70%),
    linear-gradient(180deg, #0d0a18 0%, #0a0a0e 100%);
}

.hub-hero-bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 60px,
    rgba(201,168,76,0.015) 60px,
    rgba(201,168,76,0.015) 61px
  );
}

.hub-hero-content {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 2rem;
}

.hub-eyebrow {
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.7rem;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 0.8rem;
}

.hub-title {
  font-family: 'Cinzel', serif;
  font-weight: 900;
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text);
  text-shadow: 0 0 40px rgba(124,77,255,0.3);
  margin-bottom: 1rem;
}

.hub-ornament {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.8rem;
  margin-bottom: 1rem;
}

.hub-line {
  display: block;
  width: 60px;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--gold-dim));
}

.hub-ornament .hub-line:last-child {
  background: linear-gradient(90deg, var(--gold-dim), transparent);
}

.hub-diamond {
  display: block;
  width: 7px; height: 7px;
  background: var(--gold);
  transform: rotate(45deg);
}

.hub-desc {
  font-family: 'Crimson Pro', serif;
  font-style: italic;
  font-size: 1.05rem;
  color: var(--text-dim);
  max-width: 500px;
  margin: 0 auto;
}

/* ── MAIN ── */
.hub-main {
  max-width: 1200px;
  margin: 0 auto;
  padding: 3rem 2rem 5rem;
}

/* ── FILTRES ── */
.hub-filtres {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 1rem;
  justify-content: center;
}

.filtre-btn {
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.72rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--text-dim);
  background: transparent;
  border: 1px solid var(--border);
  padding: 0.45rem 1.2rem;
  cursor: pointer;
  transition: all 0.2s;
}

.filtre-btn:hover {
  color: var(--text);
  border-color: var(--gold-dim);
}

.filtre-btn.active {
  color: var(--bg-deep);
  background: var(--gold);
  border-color: var(--gold);
  font-weight: 600;
}

/* ── COMPTEUR ── */
.hub-compteur {
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.72rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--text-dim);
  text-align: center;
  margin-bottom: 2.5rem;
}

/* ── GRILLE ── */
.hub-grille {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 3px;
}

/* ── CARTE ── */
.perso-carte {
  position: relative;
  aspect-ratio: 2/3;
  overflow: hidden;
  display: block;
  text-decoration: none;
  background: var(--bg-card);
}

.perso-carte-img {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center top;
  background-color: var(--bg-card);
  transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.perso-carte:hover .perso-carte-img {
  transform: scale(1.06);
}

.perso-carte-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    transparent 30%,
    rgba(10,10,14,0.6) 60%,
    rgba(10,10,14,0.97) 100%
  );
  transition: opacity 0.3s;
}

.perso-carte:hover .perso-carte-overlay {
  opacity: 0.9;
}

.perso-carte-content {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 1.5rem;
  transform: translateY(0);
  transition: transform 0.35s ease;
}

.perso-carte:hover .perso-carte-content {
  transform: translateY(-2.2rem);
}

.perso-carte-role {
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.6rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 0.3rem;
}

.perso-carte-nom {
  font-family: 'Cinzel', serif;
  font-weight: 700;
  font-size: 1.1rem;
  letter-spacing: 0.04em;
  color: var(--text);
  line-height: 1.15;
  margin-bottom: 0.25rem;
}

.perso-carte-surnom {
  font-family: 'Crimson Pro', serif;
  font-style: italic;
  font-size: 0.88rem;
  color: var(--text-mid);
}

.perso-carte-hover {
  position: absolute;
  bottom: 1.5rem; left: 1.5rem; right: 1.5rem;
  opacity: 0;
  transform: translateY(6px);
  transition: all 0.3s ease 0.05s;
}

.perso-carte:hover .perso-carte-hover {
  opacity: 1;
  transform: translateY(0);
}

.perso-carte-cta {
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.7rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--gold-light);
}

/* ── VIDE ── */
.hub-vide {
  text-align: center;
  padding: 4rem 2rem;
  font-family: 'Crimson Pro', serif;
  font-style: italic;
  font-size: 1.1rem;
  color: var(--text-dim);
}

/* ── RESPONSIVE ── */
@media (max-width: 900px) {
  .hub-grille { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 560px) {
  .hub-grille { grid-template-columns: 1fr 1fr; }
  .perso-carte-nom { font-size: 0.9rem; }
  .hub-main { padding: 2rem 1rem 3rem; }
}
</style>

<script>
  const filtres  = document.querySelectorAll('.filtre-btn')
  const cartes   = document.querySelectorAll('.perso-carte')
  const compteur = document.getElementById('compteurNum')
  const vide     = document.getElementById('hubVide')

  filtres.forEach(btn => {
    btn.addEventListener('click', () => {
      // Activer le bon bouton
      filtres.forEach(b => b.classList.remove('active'))
      btn.classList.add('active')

      const role = btn.dataset.role

      let visible = 0
      cartes.forEach(carte => {
        const match = role === 'Tous' || carte.dataset.role === role
        carte.style.display = match ? 'block' : 'none'
        if (match) visible++
      })

      compteur.textContent = visible
      vide.style.display = visible === 0 ? 'block' : 'none'
    })
  })
</script>
