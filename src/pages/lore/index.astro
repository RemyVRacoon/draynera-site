---
import Base from '../../layouts/Base.astro'
import { sanityClient } from '../../lib/sanity.js'

const ages = await sanityClient.fetch(`
  *[_type == "age"] | order(ordre asc) {
    titre, slug, description, ordre,
    "imageUrl": imageHero.asset->url,
    "articles": *[_type == "articleLore" && references(^._id)] | order(ordre asc) {
      titre, slug, description,
      "imageBtnUrl": imageBtn.asset->url
    }
  }
`)

const friseCount = await sanityClient.fetch(`count(*[_type == "evenementFrise"])`)
---

<Base title="Lore">

<!-- HERO -->
<section class="hub-hero">
  <div class="hub-hero-bg"></div>
  <div class="hub-hero-content">
    <p class="hub-eyebrow">Univers · Draynera</p>
    <h1 class="hub-title">Histoire & Lore</h1>
    <div class="hub-ornament">
      <span class="hub-line"></span>
      <span class="hub-diamond"></span>
      <span class="hub-line"></span>
    </div>
    <p class="hub-desc">Explore les âges qui ont façonné le monde de Draynera, des origines jusqu'à l'ère actuelle.</p>
  </div>
</section>

<section class="lore-main">

  <!-- ── FRISE CHRONOLOGIQUE ── -->
  <div class="frise-wrapper">
    <a href="/lore/frise" class="frise-btn">
      <div class="frise-btn-bg"></div>
      <div class="frise-btn-overlay"></div>
      <div class="frise-btn-content">
        <p class="frise-btn-eyebrow">Navigation temporelle</p>
        <h2 class="frise-btn-titre">Frise Chronologique</h2>
        <p class="frise-btn-sub">
          {friseCount > 0 ? `${friseCount} événement${friseCount > 1 ? 's' : ''}` : 'Explorer l\'histoire'}
        </p>
        <span class="frise-btn-cta">
          Parcourir →
        </span>
      </div>
    </a>
  </div>

  <!-- ── SÉPARATEUR ── -->
  <div class="lore-separateur">
    <div class="sep-ligne"></div>
    <div class="sep-centre">
      <span class="sep-diamond"></span>
      <span class="sep-label">Les Âges</span>
      <span class="sep-diamond"></span>
    </div>
    <div class="sep-ligne"></div>
  </div>

  <!-- ── AGES ACCORDÉON ── -->
  <div class="ages-liste" id="agesListe">
    {ages.map((age, i) => (
      <div class="age-item" id={`age-${age.slug.current}`}>

        <!-- Bouton principal de l'âge -->
        <button
          class="age-btn"
          data-age={age.slug.current}
          aria-expanded="false"
          aria-controls={`articles-${age.slug.current}`}
        >
          {age.imageUrl && (
            <div class="age-btn-bg" style={`background-image: url(${age.imageUrl})`}></div>
          )}
          <div class="age-btn-overlay"></div>
          <div class="age-btn-content">
            <div class="age-btn-left">
              <p class="age-btn-num">0{i + 1}</p>
              <div>
                <h3 class="age-btn-titre">{age.titre}</h3>
                {age.description && <p class="age-btn-desc">{age.description}</p>}
              </div>
            </div>
            <div class="age-btn-right">
              <span class="age-btn-count">
                {age.articles?.length || 0} article{age.articles?.length !== 1 ? 's' : ''}
              </span>
              <span class="age-btn-chevron">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <path d="M5 7.5l5 5 5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </div>
        </button>

        <!-- Sous-boutons (articles) -->
        <div
          class="age-articles"
          id={`articles-${age.slug.current}`}
          aria-hidden="true"
        >
          <div class="age-articles-inner">
            {age.articles && age.articles.length > 0 ? (
              age.articles.map(article => (
                <a
                  href={`/lore/${article.slug.current}`}
                  class="article-btn"
                >
                  {article.imageBtnUrl && (
                    <div class="article-btn-bg" style={`background-image: url(${article.imageBtnUrl})`}></div>
                  )}
                  <div class="article-btn-overlay"></div>
                  <div class="article-btn-content">
                    <span class="article-btn-titre">{article.titre}</span>
                    {article.description && (
                      <span class="article-btn-desc">{article.description}</span>
                    )}
                    <span class="article-btn-fleche">→</span>
                  </div>
                </a>
              ))
            ) : (
              <div class="age-vide">
                <p>Aucun article disponible pour cet âge.</p>
              </div>
            )}
          </div>
        </div>

      </div>
    ))}
  </div>

  {ages.length === 0 && (
    <div class="hub-vide">
      <p>Aucun âge historique n'a encore été créé.</p>
    </div>
  )}

</section>

</Base>

<style>

/* ── HERO ── */
.hub-hero {
  position: relative;
  height: 40vh;
  min-height: 320px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 56px;
  overflow: hidden;
}

.hub-hero-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 80% 100% at 50% 0%, rgba(160,100,20,0.12) 0%, transparent 70%),
    linear-gradient(180deg, #180e0a 0%, #0a0a0e 100%);
}

.hub-hero-bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    -45deg,
    transparent,
    transparent 40px,
    rgba(201,168,76,0.008) 40px,
    rgba(201,168,76,0.008) 41px
  );
}

.hub-hero-content {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 2rem;
}

.hub-eyebrow {
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.7rem;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 0.8rem;
}

.hub-title {
  font-family: 'Cinzel', serif;
  font-weight: 900;
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text);
  text-shadow: 0 0 40px rgba(160,100,20,0.4);
  margin-bottom: 1rem;
}

.hub-ornament {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.8rem;
  margin-bottom: 1rem;
}

.hub-line {
  display: block;
  width: 60px;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--gold-dim));
}

.hub-ornament .hub-line:last-child {
  background: linear-gradient(90deg, var(--gold-dim), transparent);
}

.hub-diamond {
  display: block;
  width: 7px; height: 7px;
  background: var(--gold);
  transform: rotate(45deg);
}

.hub-desc {
  font-family: 'Crimson Pro', serif;
  font-style: italic;
  font-size: 1.05rem;
  color: var(--text-dim);
  max-width: 560px;
  margin: 0 auto;
}

/* ── MAIN ── */
.lore-main {
  max-width: 960px;
  margin: 0 auto;
  padding: 3rem 2rem 6rem;
}

/* ── FRISE BTN ── */
.frise-wrapper {
  margin-bottom: 3rem;
}

.frise-btn {
  position: relative;
  display: block;
  width: 100%;
  height: 160px;
  overflow: hidden;
  text-decoration: none;
  border: 1px solid var(--border);
  cursor: pointer;
}

.frise-btn-bg {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(135deg, #1a1208 0%, #0d0a05 100%);
  background-size: cover;
  background-position: center;
  transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94),
              filter 0.6s ease;
  filter: brightness(0.6) saturate(0.7);
}

.frise-btn:hover .frise-btn-bg {
  transform: scale(1.06);
  filter: brightness(0.4) saturate(0.4) blur(3px);
}

.frise-btn-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(10,8,4,0.85) 0%, rgba(10,8,4,0.4) 100%);
}

.frise-btn-content {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 3rem;
  gap: 0.3rem;
}

.frise-btn-eyebrow {
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.65rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--gold);
}

.frise-btn-titre {
  font-family: 'Cinzel', serif;
  font-weight: 900;
  font-size: clamp(1.6rem, 3vw, 2.4rem);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text);
  text-shadow: 0 2px 10px rgba(0,0,0,0.5);
}

.frise-btn-sub {
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.72rem;
  letter-spacing: 0.15em;
  color: var(--text-dim);
}

.frise-btn-cta {
  display: inline-block;
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.72rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--gold-light);
  margin-top: 0.5rem;
  opacity: 0;
  transform: translateX(-8px);
  transition: all 0.3s ease;
}

.frise-btn:hover .frise-btn-cta {
  opacity: 1;
  transform: translateX(0);
}

/* ── SÉPARATEUR ── */
.lore-separateur {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.sep-ligne {
  flex: 1;
  height: 1px;
  background: var(--border);
}

.sep-centre {
  display: flex;
  align-items: center;
  gap: 0.8rem;
  flex-shrink: 0;
}

.sep-diamond {
  display: block;
  width: 5px; height: 5px;
  background: var(--gold-dim);
  transform: rotate(45deg);
}

.sep-label {
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.65rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--text-dim);
}

/* ── AGES LISTE ── */
.ages-liste {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

/* ── AGE BTN ── */
.age-btn {
  position: relative;
  width: 100%;
  height: 100px;
  overflow: hidden;
  border: 1px solid var(--border);
  cursor: pointer;
  background: var(--bg-card);
  padding: 0;
  transition: border-color 0.3s;
}

.age-btn:hover,
.age-btn[aria-expanded="true"] {
  border-color: var(--gold-dim);
}

.age-btn-bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  filter: brightness(0.4) saturate(0.6);
  transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94),
              filter 0.6s ease;
}

.age-btn:hover .age-btn-bg {
  transform: scale(1.06);
  filter: brightness(0.25) saturate(0.3) blur(3px);
}

.age-btn[aria-expanded="true"] .age-btn-bg {
  filter: brightness(0.2) saturate(0.2) blur(4px);
}

.age-btn-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(10,10,14,0.9) 0%, rgba(10,10,14,0.5) 60%, rgba(10,10,14,0.3) 100%);
}

.age-btn-content {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 2.5rem;
  gap: 2rem;
}

.age-btn-left {
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

.age-btn-num {
  font-family: 'Cinzel', serif;
  font-size: 2rem;
  font-weight: 900;
  color: var(--gold-dim);
  line-height: 1;
  flex-shrink: 0;
}

.age-btn-titre {
  font-family: 'Cinzel', serif;
  font-weight: 700;
  font-size: 1.2rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text);
  text-align: left;
  margin-bottom: 0.2rem;
}

.age-btn-desc {
  font-family: 'Crimson Pro', serif;
  font-style: italic;
  font-size: 0.9rem;
  color: var(--text-dim);
  text-align: left;
}

.age-btn-right {
  display: flex;
  align-items: center;
  gap: 1.2rem;
  flex-shrink: 0;
}

.age-btn-count {
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.65rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--text-dim);
}

.age-btn-chevron {
  color: var(--text-dim);
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  display: flex;
}

.age-btn[aria-expanded="true"] .age-btn-chevron {
  transform: rotate(180deg);
  color: var(--gold);
}

/* ── ARTICLES ACCORDÉON ── */
.age-articles {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
}

.age-articles[aria-hidden="false"] {
  max-height: 800px;
}

.age-articles-inner {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 2px 0 2px 2rem;
  border-left: 2px solid var(--gold-dim);
  margin-left: 1px;
}

/* ── ARTICLE BTN ── */
.article-btn {
  position: relative;
  display: flex;
  height: 72px;
  overflow: hidden;
  text-decoration: none;
  border: 1px solid var(--border);
  background: var(--bg-card2);
  transition: border-color 0.2s;
}

.article-btn:hover {
  border-color: var(--gold-dim);
}

.article-btn-bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  filter: brightness(0.3) saturate(0.5);
  transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94),
              filter 0.6s ease;
}

.article-btn:hover .article-btn-bg {
  transform: scale(1.08);
  filter: brightness(0.2) saturate(0.3) blur(3px);
}

.article-btn-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(10,10,14,0.95) 0%, rgba(10,10,14,0.6) 100%);
}

.article-btn-content {
  position: relative;
  z-index: 1;
  width: 100%;
  display: flex;
  align-items: center;
  padding: 0 2rem;
  gap: 1rem;
}

.article-btn-titre {
  font-family: 'Cinzel', serif;
  font-weight: 600;
  font-size: 0.95rem;
  letter-spacing: 0.04em;
  color: var(--text);
  flex: 1;
}

.article-btn-desc {
  font-family: 'Crimson Pro', serif;
  font-style: italic;
  font-size: 0.85rem;
  color: var(--text-dim);
  flex: 2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.article-btn-fleche {
  font-family: 'Rajdhani', sans-serif;
  font-size: 1rem;
  color: var(--text-dim);
  transition: all 0.2s;
  flex-shrink: 0;
}

.article-btn:hover .article-btn-fleche {
  color: var(--gold);
  transform: translateX(4px);
}

/* ── VIDE ── */
.age-vide {
  padding: 1.5rem 2rem;
  font-family: 'Crimson Pro', serif;
  font-style: italic;
  font-size: 0.95rem;
  color: var(--text-dim);
  background: var(--bg-card2);
  border: 1px solid var(--border);
}

.hub-vide {
  text-align: center;
  padding: 4rem 2rem;
  font-family: 'Crimson Pro', serif;
  font-style: italic;
  font-size: 1.1rem;
  color: var(--text-dim);
  border: 1px solid var(--border);
}

/* ── RESPONSIVE ── */
@media (max-width: 700px) {
  .lore-main { padding: 2rem 1rem 4rem; }
  .age-btn-content { padding: 0 1.2rem; }
  .age-btn-desc { display: none; }
  .article-btn-desc { display: none; }
  .frise-btn-content { padding: 0 1.5rem; }
}
</style>

<script>
  // Accordéon des âges
  const ageBtns = document.querySelectorAll('.age-btn')

  ageBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('aria-controls')
      const target   = document.getElementById(targetId)
      const isOpen   = btn.getAttribute('aria-expanded') === 'true'

      // Ferme tous les autres
      ageBtns.forEach(otherBtn => {
        if (otherBtn !== btn) {
          otherBtn.setAttribute('aria-expanded', 'false')
          const otherId     = otherBtn.getAttribute('aria-controls')
          const otherTarget = document.getElementById(otherId)
          if (otherTarget) otherTarget.setAttribute('aria-hidden', 'true')
        }
      })

      // Toggle celui-ci
      btn.setAttribute('aria-expanded', String(!isOpen))
      if (target) target.setAttribute('aria-hidden', String(isOpen))
    })
  })
</script>
