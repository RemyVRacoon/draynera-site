---
import Lecture from '../../layouts/Lecture.astro'
import { sanityClient } from '../../lib/sanity.js'
import { portableTextToHTML } from '../../lib/portableText.js'

export async function getStaticPaths() {
  const nouvelles = await sanityClient.fetch(`*[_type == "nouvelle"]{ slug }`)
  return nouvelles.map(n => ({ params: { slug: n.slug.current } }))
}

const { slug } = Astro.params
const nouvelle = await sanityClient.fetch(
  `*[_type == "nouvelle" && slug.current == $slug][0]{
    titre, auteur, resume,
    "imageUrl": image.asset->url,
    "contenu": contenu[]{
      ...,
      markDefs[]{
        ...,
        _type == "termeLore" => {
          "definition": definition->{
            slug, categorie, terme
          }
        }
      }
    }
  }`,
  { slug }
)

if (!nouvelle) return Astro.redirect('/nouvelles')

const contenuHTML = portableTextToHTML(nouvelle.contenu)
---

<Lecture
  titre={nouvelle.titre}
  sousTitre={nouvelle.resume}
  auteur={nouvelle.auteur}
  imageUrl={nouvelle.imageUrl}
  retourHref="/nouvelles"
  retourLabel="Toutes les nouvelles"
  type="Nouvelle"
>
  <Fragment set:html={contenuHTML} />
</Lecture>
