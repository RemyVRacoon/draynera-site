---
import Base from '../../layouts/Base.astro'
import { sanityClient } from '../../lib/sanity.js'

const lieux = await sanityClient.fetch(`
  *[_type == "lieu"] | order(nom asc) {
    nom, slug, description,
    "imageHeroUrl": imageHero.asset->url
  }
`)
---

<Base title="Lieux">

<section class="hub-hero">
  <div class="hub-hero-bg"></div>
  <div class="hub-hero-content">
    <p class="hub-eyebrow">Univers · Draynera</p>
    <h1 class="hub-title">Lieux</h1>
    <div class="hub-ornament">
      <span class="hub-line"></span>
      <span class="hub-diamond"></span>
      <span class="hub-line"></span>
    </div>
    <p class="hub-desc">Explore les régions, villes et territoires qui composent le monde de Draynera.</p>
  </div>
</section>

<section class="hub-main">

  <!-- Compteur -->
  <p class="hub-compteur">
    <span>{lieux.length}</span> lieu{lieux.length > 1 ? 'x' : ''}
  </p>

  <!-- Grille -->
  {lieux.length > 0 ? (
    <div class="hub-grille">
      {lieux.map(lieu => (
        <a
          href={`/lieux/${lieu.slug.current}`}
          class="lieu-carte"
        >
          <div
            class="lieu-carte-img"
            style={lieu.imageHeroUrl ? `background-image: url(${lieu.imageHeroUrl})` : ''}
          ></div>
          <div class="lieu-carte-overlay"></div>
          <div class="lieu-carte-content">
            <h2 class="lieu-carte-nom">{lieu.nom}</h2>
            {lieu.description && <p class="lieu-carte-desc">{lieu.description}</p>}
            <span class="lieu-carte-cta">Explorer →</span>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div class="hub-vide">
      <p>Aucun lieu n'a encore été ajouté.</p>
    </div>
  )}

</section>

</Base>

<style>

/* ── HERO ── */
.hub-hero {
  position: relative;
  height: 40vh;
  min-height: 320px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 56px;
  overflow: hidden;
}

.hub-hero-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 80% 100% at 50% 0%, rgba(40,80,160,0.12) 0%, transparent 70%),
    linear-gradient(180deg, #0a0e18 0%, #0a0a0e 100%);
}

.hub-hero-bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    90deg,
    transparent,
    transparent 80px,
    rgba(201,168,76,0.012) 80px,
    rgba(201,168,76,0.012) 81px
  );
}

.hub-hero-content {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 2rem;
}

.hub-eyebrow {
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.7rem;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 0.8rem;
}

.hub-title {
  font-family: 'Cinzel', serif;
  font-weight: 900;
  font-size: clamp(2.5rem, 6vw, 4.5rem);
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text);
  text-shadow: 0 0 40px rgba(40,80,160,0.4);
  margin-bottom: 1rem;
}

.hub-ornament {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.8rem;
  margin-bottom: 1rem;
}

.hub-line {
  display: block;
  width: 60px;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--gold-dim));
}

.hub-ornament .hub-line:last-child {
  background: linear-gradient(90deg, var(--gold-dim), transparent);
}

.hub-diamond {
  display: block;
  width: 7px; height: 7px;
  background: var(--gold);
  transform: rotate(45deg);
}

.hub-desc {
  font-family: 'Crimson Pro', serif;
  font-style: italic;
  font-size: 1.05rem;
  color: var(--text-dim);
  max-width: 500px;
  margin: 0 auto;
}

/* ── MAIN ── */
.hub-main {
  max-width: 1200px;
  margin: 0 auto;
  padding: 3rem 2rem 5rem;
}

/* ── COMPTEUR ── */
.hub-compteur {
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.72rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--text-dim);
  text-align: center;
  margin-bottom: 2.5rem;
}

/* ── GRILLE ── */
.hub-grille {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 3px;
}

/* ── CARTE LIEU ── */
.lieu-carte {
  position: relative;
  aspect-ratio: 16/9;
  overflow: hidden;
  display: block;
  text-decoration: none;
  background: var(--bg-card);
}

.lieu-carte-img {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  background-color: var(--bg-card);
  filter: grayscale(0.2) brightness(0.75);
  transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94),
              filter 0.5s ease;
}

.lieu-carte:hover .lieu-carte-img {
  transform: scale(1.05);
  filter: grayscale(0) brightness(0.85);
}

.lieu-carte-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, transparent 20%, rgba(10,10,14,0.97) 100%),
    linear-gradient(90deg, rgba(10,10,14,0.3) 0%, transparent 60%);
  transition: opacity 0.3s;
}

.lieu-carte-content {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 2rem;
}

.lieu-carte-nom {
  font-family: 'Cinzel', serif;
  font-weight: 900;
  font-size: clamp(1.3rem, 2.5vw, 2rem);
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text);
  line-height: 1.1;
  margin-bottom: 0.5rem;
  text-shadow: 0 2px 10px rgba(0,0,0,0.5);
}

.lieu-carte-desc {
  font-family: 'Crimson Pro', serif;
  font-size: 0.95rem;
  line-height: 1.5;
  color: var(--text-mid);
  margin-bottom: 0.8rem;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  opacity: 0;
  transform: translateY(8px);
  transition: all 0.35s ease;
}

.lieu-carte-cta {
  display: inline-block;
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.7rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--gold-light);
  opacity: 0;
  transform: translateY(8px);
  transition: all 0.35s ease 0.05s;
}

.lieu-carte:hover .lieu-carte-desc,
.lieu-carte:hover .lieu-carte-cta {
  opacity: 1;
  transform: translateY(0);
}

/* ── VIDE ── */
.hub-vide {
  text-align: center;
  padding: 4rem 2rem;
  font-family: 'Crimson Pro', serif;
  font-style: italic;
  font-size: 1.1rem;
  color: var(--text-dim);
  border: 1px solid var(--border);
}

/* ── RESPONSIVE ── */
@media (max-width: 700px) {
  .hub-grille { grid-template-columns: 1fr; }
  .hub-main { padding: 2rem 1rem 3rem; }
}
</style>
