---
import Base from '../layouts/Base.astro'
import { sanityClient, imageUrl } from '../lib/sanity.js'

// Récupère les 6 personnages pour le carrousel
const personnagesCarrousel = await sanityClient.fetch(`
  *[_type == "personnage" && misEnAvantCarrousel == true] | order(ordreCarrousel asc) [0...6] {
    nom, surnom, slug, imageHero, couleurAccent
  }
`)

// Récupère les 5 derniers personnages publiés
const dernierPersonnages = await sanityClient.fetch(`
  *[_type == "personnage"] | order(_createdAt desc) [0...5] {
    nom, surnom, slug, imageHero, imageDesign, role, _createdAt, nouveau
  }
`)

// Récupère les lieux mis en avant
const lieux = await sanityClient.fetch(`
  *[_type == "lieu" && misEnAvant == true] | order(ordre asc) [0...6] {
    nom, slug, description, imageHero, couleurAccent
  }
`)
---

<Base title="Accueil">

<!-- ═══════════════════════════════════════════
     HERO CARROUSEL
═══════════════════════════════════════════ -->
<section class="carrousel" id="carrousel">
  <div class="carrousel-track" id="carrouselTrack">
    {personnagesCarrousel.map((perso, i) => {
      const hero = imageUrl(perso.imageHero)
      return (
        <div class="carrousel-slide" data-index={i} style={hero ? `--slide-bg: url(${hero})` : ''}>
          <div class="slide-bg"></div>
          <div class="slide-gradient"></div>
          <div class="slide-content">
            <div class="slide-inner">
              <p class="slide-eyebrow">Personnage</p>
              <h2 class="slide-name">{perso.nom}</h2>
              {perso.surnom && <p class="slide-surnom">{perso.surnom}</p>}
              <a href={`/personnages/${perso.slug.current}`} class="slide-cta">
                <span>Découvrir</span>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      )
    })}
  </div>

  <!-- Navigation -->
  <button class="carrousel-btn prev" id="prevBtn" aria-label="Précédent">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
      <path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
  <button class="carrousel-btn next" id="nextBtn" aria-label="Suivant">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
      <path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <!-- Indicateurs -->
  <div class="carrousel-dots" id="carrouselDots">
    {personnagesCarrousel.map((_, i) => (
      <button class={`dot ${i === 0 ? 'active' : ''}`} data-dot={i} aria-label={`Slide ${i + 1}`}></button>
    ))}
  </div>

  <!-- Miniatures -->
  <div class="carrousel-thumbs" id="carrouselThumbs">
    {personnagesCarrousel.map((perso, i) => {
      const hero = imageUrl(perso.imageHero)
      return (
        <button class={`thumb ${i === 0 ? 'active' : ''}`} data-thumb={i} style={hero ? `--thumb-bg: url(${hero})` : ''}>
          <div class="thumb-bg"></div>
          <span class="thumb-name">{perso.nom.split(' ')[0]}</span>
        </button>
      )
    })}
  </div>
</section>

<!-- ═══════════════════════════════════════════
     SECTION DERNIÈREMENT
═══════════════════════════════════════════ -->
<section class="dernieres" id="dernieres">
  <div class="dernieres-inner">

    <header class="section-header">
      <div class="section-ornament-line"></div>
      <div class="section-title-group">
        <p class="section-eyebrow">Univers · Personnages</p>
        <h2 class="section-title">Dernièrement</h2>
      </div>
      <div class="section-ornament-line"></div>
    </header>

    <div class="dernieres-grid">

      <!-- Grande carte principale -->
      {dernierPersonnages[0] && (() => {
        const perso = dernierPersonnages[0]
        const hero = imageUrl(perso.imageHero)
        return (
          <a href={`/personnages/${perso.slug.current}`} class="carte-principale">
            <div class="carte-img" style={hero ? `--img: url(${hero})` : ''}></div>
            <div class="carte-overlay"></div>
            <div class="carte-content">
              {perso.nouveau && <span class="badge-nouveau">Nouveau</span>}
              <p class="carte-type">Personnage</p>
              <h3 class="carte-nom">{perso.nom}</h3>
              {perso.surnom && <p class="carte-surnom">{perso.surnom}</p>}
            </div>
          </a>
        )
      })()}

      <!-- 4 petites cartes -->
      <div class="cartes-secondaires">
        {dernierPersonnages.slice(1, 5).map(perso => {
          const hero = imageUrl(perso.imageHero)
          return (
            <a href={`/personnages/${perso.slug.current}`} class="carte-secondaire">
              <div class="carte-s-img" style={hero ? `--img: url(${hero})` : ''}></div>
              <div class="carte-s-overlay"></div>
              <div class="carte-s-content">
                {perso.nouveau && <span class="badge-nouveau badge-sm">Nouveau</span>}
                <p class="carte-s-type">Personnage</p>
                <h3 class="carte-s-nom">{perso.nom}</h3>
              </div>
            </a>
          )
        })}
      </div>

    </div>

    <div class="dernieres-footer">
      <a href="/personnages" class="btn-voir-tous">
        Voir tous les personnages
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<!-- ═══════════════════════════════════════════
     SECTION LIEUX À L'AFFICHE
═══════════════════════════════════════════ -->
<section class="regions" id="regions">
  <div class="regions-inner">

    <header class="section-header">
      <div class="section-ornament-line"></div>
      <div class="section-title-group">
        <p class="section-eyebrow">Univers · Cartographie</p>
        <h2 class="section-title">Lieux à l'Affiche</h2>
      </div>
      <div class="section-ornament-line"></div>
    </header>

    <div class="regions-scroll" id="regionsScroll">
      <div class="regions-track">
        {lieux.map(lieu => {
          const hero = imageUrl(lieu.imageHero)
          return (
            <a href={`/lieux/${lieu.slug.current}`} class="region-carte">
              <div class="region-img" style={hero ? `--img: url(${hero})` : ''}></div>
              <div class="region-overlay"></div>
              <div class="region-content">
                <h3 class="region-nom">{lieu.nom}</h3>
                {lieu.description && <p class="region-desc">{lieu.description}</p>}
              </div>
            </a>
          )
        })}
      </div>
    </div>

    <div class="regions-footer">
      <a href="/lieux" class="btn-voir-tous">
        Explorer tous les lieux
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

  </div>
</section>

</Base>

<style>

/* ═══════════════════════════════════════════
   CARROUSEL
═══════════════════════════════════════════ */
.carrousel {
  position: relative;
  width: 100%;
  height: 100vh;
  min-height: 700px;
  overflow: hidden;
  margin-top: 56px; /* hauteur nav */
}

.carrousel-track {
  display: flex;
  width: 100%;
  height: 100%;
  transition: transform 0.9s cubic-bezier(0.77, 0, 0.175, 1);
}

.carrousel-slide {
  position: relative;
  min-width: 100%;
  height: 100%;
  overflow: hidden;
}

.slide-bg {
  position: absolute;
  inset: 0;
  background-image: var(--slide-bg);
  background-size: cover;
  background-position: center top;
  transform: scale(1.05);
  transition: transform 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.carrousel-slide.active .slide-bg {
  transform: scale(1);
}

.slide-gradient {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(10,10,14,0.92) 0%, rgba(10,10,14,0.5) 50%, rgba(10,10,14,0.1) 100%),
    linear-gradient(180deg, rgba(10,10,14,0.2) 0%, transparent 30%, rgba(10,10,14,0.8) 85%, rgba(10,10,14,1) 100%);
}

.slide-content {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  padding: 0 8%;
}

.slide-inner {
  max-width: 520px;
  opacity: 0;
  transform: translateY(30px);
  transition: opacity 0.8s 0.3s ease, transform 0.8s 0.3s ease;
}

.carrousel-slide.active .slide-inner {
  opacity: 1;
  transform: translateY(0);
}

.slide-eyebrow {
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.72rem;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 0.8rem;
}

.slide-name {
  font-family: 'Cinzel', serif;
  font-weight: 900;
  font-size: clamp(2.8rem, 6vw, 5rem);
  letter-spacing: 0.03em;
  text-transform: uppercase;
  color: var(--text);
  line-height: 0.95;
  margin-bottom: 0.8rem;
  text-shadow: 0 2px 30px rgba(0,0,0,0.5);
}

.slide-surnom {
  font-family: 'Crimson Pro', serif;
  font-style: italic;
  font-size: 1.1rem;
  color: var(--text-mid);
  margin-bottom: 2rem;
  letter-spacing: 0.05em;
}

.slide-cta {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.78rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--text);
  border: 1px solid var(--gold-dim);
  padding: 0.8rem 1.8rem;
  text-decoration: none;
  background: rgba(201,168,76,0.06);
  transition: all 0.25s;
}

.slide-cta:hover {
  background: rgba(201,168,76,0.14);
  border-color: var(--gold);
  color: var(--gold-light);
  gap: 0.9rem;
}

/* Boutons nav */
.carrousel-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
  background: rgba(10,10,14,0.6);
  border: 1px solid var(--border);
  color: var(--text-mid);
  width: 48px; height: 48px;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  transition: all 0.2s;
  backdrop-filter: blur(8px);
}

.carrousel-btn:hover {
  background: rgba(201,168,76,0.15);
  border-color: var(--gold-dim);
  color: var(--gold-light);
}

.carrousel-btn.prev { left: 2rem; }
.carrousel-btn.next { right: 2rem; }

/* Dots */
.carrousel-dots {
  position: absolute;
  bottom: 10rem;
  left: 8%;
  display: flex;
  gap: 0.5rem;
  z-index: 10;
}

.dot {
  width: 24px; height: 2px;
  background: rgba(255,255,255,0.25);
  border: none;
  cursor: pointer;
  transition: all 0.3s;
  padding: 0;
}

.dot.active {
  width: 40px;
  background: var(--gold);
}

/* Miniatures */
.carrousel-thumbs {
  position: absolute;
  bottom: 2rem;
  left: 0; right: 0;
  display: flex;
  justify-content: center;
  gap: 0.75rem;
  z-index: 10;
  padding: 0 2rem;
}

.thumb {
  position: relative;
  width: 120px;
  height: 70px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.1);
  cursor: pointer;
  background: none;
  padding: 0;
  transition: all 0.3s;
  flex-shrink: 0;
}

.thumb-bg {
  position: absolute;
  inset: 0;
  background-image: var(--thumb-bg);
  background-size: cover;
  background-position: center;
  filter: grayscale(0.6) brightness(0.6);
  transition: all 0.3s;
}

.thumb.active {
  border-color: var(--gold);
}

.thumb.active .thumb-bg {
  filter: grayscale(0) brightness(0.8);
}

.thumb:hover .thumb-bg {
  filter: grayscale(0.2) brightness(0.75);
}

.thumb-name {
  position: absolute;
  bottom: 0.3rem;
  left: 0; right: 0;
  text-align: center;
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.65rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--text);
  z-index: 1;
}

/* ═══════════════════════════════════════════
   SECTION DERNIÈREMENT
═══════════════════════════════════════════ */
.dernieres {
  background: var(--bg-deep);
  padding: 5rem 0 4rem;
}

.dernieres-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 3rem;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 2rem;
  margin-bottom: 3rem;
}

.section-ornament-line {
  flex: 1;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--border));
}

.section-ornament-line:last-child {
  background: linear-gradient(90deg, var(--border), transparent);
}

.section-title-group {
  text-align: center;
  flex-shrink: 0;
}

.section-eyebrow {
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.65rem;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--gold);
  margin-bottom: 0.3rem;
}

.section-title {
  font-family: 'Cinzel', serif;
  font-weight: 900;
  font-size: 1.8rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text);
}

/* Grille */
.dernieres-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3px;
}

/* Grande carte */
.carte-principale {
  position: relative;
  aspect-ratio: 3/4;
  overflow: hidden;
  display: block;
  text-decoration: none;
}

.carte-img {
  position: absolute;
  inset: 0;
  background-image: var(--img);
  background-size: cover;
  background-position: center top;
  transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.carte-principale:hover .carte-img {
  transform: scale(1.04);
}

.carte-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 30%, rgba(10,10,14,0.95) 100%);
  transition: opacity 0.3s;
}

.carte-principale:hover .carte-overlay {
  opacity: 0.85;
}

.carte-content {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 2rem;
}

.badge-nouveau {
  display: inline-block;
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.6rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--bg-deep);
  background: var(--gold);
  padding: 0.2rem 0.6rem;
  margin-bottom: 0.6rem;
}

.badge-sm { font-size: 0.55rem; padding: 0.15rem 0.5rem; }

.carte-type {
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.65rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--text-dim);
  margin-bottom: 0.3rem;
}

.carte-nom {
  font-family: 'Cinzel', serif;
  font-weight: 700;
  font-size: 1.6rem;
  letter-spacing: 0.04em;
  color: var(--text);
  line-height: 1.1;
  margin-bottom: 0.3rem;
}

.carte-surnom {
  font-family: 'Crimson Pro', serif;
  font-style: italic;
  font-size: 0.95rem;
  color: var(--text-mid);
}

/* Petites cartes */
.cartes-secondaires {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: 3px;
}

.carte-secondaire {
  position: relative;
  overflow: hidden;
  display: block;
  text-decoration: none;
}

.carte-s-img {
  position: absolute;
  inset: 0;
  background-image: var(--img);
  background-size: cover;
  background-position: center top;
  transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.carte-secondaire:hover .carte-s-img {
  transform: scale(1.06);
}

.carte-s-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 20%, rgba(10,10,14,0.9) 100%);
}

.carte-s-content {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 1rem 1.2rem;
}

.carte-s-type {
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.6rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--text-dim);
  margin-bottom: 0.2rem;
}

.carte-s-nom {
  font-family: 'Cinzel', serif;
  font-weight: 700;
  font-size: 1rem;
  letter-spacing: 0.04em;
  color: var(--text);
  line-height: 1.1;
}

/* Footer section */
.dernieres-footer, .regions-footer {
  display: flex;
  justify-content: center;
  margin-top: 2.5rem;
}

.btn-voir-tous {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-family: 'Rajdhani', sans-serif;
  font-size: 0.75rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--text-mid);
  border: 1px solid var(--border);
  padding: 0.75rem 2rem;
  text-decoration: none;
  transition: all 0.25s;
  background: transparent;
}

.btn-voir-tous:hover {
  color: var(--gold-light);
  border-color: var(--gold-dim);
  background: rgba(201,168,76,0.05);
  gap: 0.9rem;
}

/* ═══════════════════════════════════════════
   SECTION LIEUX
═══════════════════════════════════════════ */
.regions {
  background: var(--bg-card2);
  padding: 5rem 0 4rem;
  border-top: 1px solid var(--border);
}

.regions-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 3rem;
}

.regions-scroll {
  overflow-x: auto;
  scrollbar-width: none;
  -ms-overflow-style: none;
  cursor: grab;
}

.regions-scroll::-webkit-scrollbar { display: none; }
.regions-scroll.grabbing { cursor: grabbing; }

.regions-track {
  display: flex;
  gap: 3px;
  width: max-content;
}

.region-carte {
  position: relative;
  width: 320px;
  height: 420px;
  overflow: hidden;
  flex-shrink: 0;
  display: block;
  text-decoration: none;
}

.region-img {
  position: absolute;
  inset: 0;
  background-image: var(--img);
  background-size: cover;
  background-position: center;
  transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  filter: grayscale(0.2) brightness(0.75);
}

.region-carte:hover .region-img {
  transform: scale(1.05);
  filter: grayscale(0) brightness(0.85);
}

.region-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, transparent 40%, rgba(10,10,14,0.97) 100%),
    linear-gradient(0deg, transparent 60%, rgba(10,10,14,0.3) 100%);
}

.region-content {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  padding: 2rem;
}

.region-nom {
  font-family: 'Cinzel', serif;
  font-weight: 900;
  font-size: 1.4rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--text);
  margin-bottom: 0.5rem;
  line-height: 1.1;
}

.region-desc {
  font-family: 'Crimson Pro', serif;
  font-size: 0.9rem;
  line-height: 1.5;
  color: var(--text-dim);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ═══════════════════════════════════════════
   RESPONSIVE
═══════════════════════════════════════════ */
@media (max-width: 900px) {
  .dernieres-grid {
    grid-template-columns: 1fr;
  }
  .cartes-secondaires {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto;
  }
  .carte-principale { aspect-ratio: 16/9; }
  .carrousel-thumbs { display: none; }
  .carrousel-dots { bottom: 2rem; left: 50%; transform: translateX(-50%); }
  .region-carte { width: 260px; height: 340px; }
  .dernieres-inner, .regions-inner { padding: 0 1.5rem; }
}

@media (max-width: 600px) {
  .cartes-secondaires { grid-template-columns: 1fr; }
  .carrousel-btn { display: none; }
  .slide-content { padding: 0 5%; }
}
</style>

<script>
  // ── CARROUSEL ──
  const track     = document.getElementById('carrouselTrack')
  const slides    = document.querySelectorAll('.carrousel-slide')
  const dots      = document.querySelectorAll('.dot')
  const thumbs    = document.querySelectorAll('.thumb')
  const prevBtn   = document.getElementById('prevBtn')
  const nextBtn   = document.getElementById('nextBtn')
  let current     = 0
  let autoTimer   = null

  function goTo(index) {
    slides[current].classList.remove('active')
    dots[current]?.classList.remove('active')
    thumbs[current]?.classList.remove('active')
    current = (index + slides.length) % slides.length
    track.style.transform = `translateX(-${current * 100}%)`
    slides[current].classList.add('active')
    dots[current]?.classList.add('active')
    thumbs[current]?.classList.add('active')
  }

  function startAuto() {
    autoTimer = setInterval(() => goTo(current + 1), 6000)
  }

  function resetAuto() {
    clearInterval(autoTimer)
    startAuto()
  }

  // Init
  slides[0]?.classList.add('active')
  startAuto()

  prevBtn?.addEventListener('click', () => { goTo(current - 1); resetAuto() })
  nextBtn?.addEventListener('click', () => { goTo(current + 1); resetAuto() })
  dots.forEach(d  => d.addEventListener('click',  () => { goTo(+d.dataset.dot);   resetAuto() }))
  thumbs.forEach(t => t.addEventListener('click', () => { goTo(+t.dataset.thumb); resetAuto() }))

  // Swipe touch
  let touchStart = 0
  track?.addEventListener('touchstart', e => { touchStart = e.touches[0].clientX }, { passive: true })
  track?.addEventListener('touchend',   e => {
    const diff = touchStart - e.changedTouches[0].clientX
    if (Math.abs(diff) > 50) { goTo(diff > 0 ? current + 1 : current - 1); resetAuto() }
  })

  // ── SCROLL DRAG LIEUX ──
  const regionsScroll = document.getElementById('regionsScroll')
  if (regionsScroll) {
    let isDown = false, startX = 0, scrollLeft = 0
    regionsScroll.addEventListener('mousedown', e => {
      isDown = true
      regionsScroll.classList.add('grabbing')
      startX = e.pageX - regionsScroll.offsetLeft
      scrollLeft = regionsScroll.scrollLeft
    })
    regionsScroll.addEventListener('mouseleave', () => { isDown = false; regionsScroll.classList.remove('grabbing') })
    regionsScroll.addEventListener('mouseup',    () => { isDown = false; regionsScroll.classList.remove('grabbing') })
    regionsScroll.addEventListener('mousemove',  e => {
      if (!isDown) return
      e.preventDefault()
      const x    = e.pageX - regionsScroll.offsetLeft
      const walk = (x - startX) * 1.5
      regionsScroll.scrollLeft = scrollLeft - walk
    })
  }

  // ── SCROLL REVEAL ──
  const reveals = document.querySelectorAll('.dernieres, .regions')
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.style.opacity = '1'
        e.target.style.transform = 'none'
      }
    })
  }, { threshold: 0.05 })
  reveals.forEach(r => {
    r.style.opacity = '0'
    r.style.transform = 'translateY(20px)'
    r.style.transition = 'opacity 0.9s ease, transform 0.9s ease'
    io.observe(r)
  })
</script>
